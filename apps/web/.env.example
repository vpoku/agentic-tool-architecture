# AWS GovCloud
AWS_REGION=us-gov-west-1
AWS_USE_FIPS_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model (GovCloud-supported)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Bedrock Knowledge Base (OpenSearch Serverless vector store)
# Create in AWS Console: Bedrock → Knowledge bases → attach OpenSearch Serverless collection
BEDROCK_KNOWLEDGE_BASE_ID=

# Force mock mode without AWS credentials
# BEDROCK_MOCK_MODE=true

# Optional DynamoDB persistence
# USE_DYNAMODB=true
# DYNAMODB_PROJECTS_TABLE=CloudArch-Projects
# DYNAMODB_MESSAGES_TABLE=CloudArch-Messages

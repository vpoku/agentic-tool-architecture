# AWS GovCloud
AWS_REGION=us-gov-west-1
AWS_USE_FIPS_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock models (GovCloud-supported)
# Default chat + architecture agent: OpenAI GPT OSS 120B
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
# Optional: separate model for architecture JSON generation
BEDROCK_ARCHITECTURE_MODEL_ID=openai.gpt-oss-120b-1:0
# GovCloud cross-region inference ID (optional): us-gov.openai.gpt-oss-120b-1:0

# Bedrock Knowledge Base (OpenSearch Serverless vector store)
# 1. Create OpenSearch Serverless collection in us-gov-west-1
# 2. Bedrock Console → Knowledge bases → Create → attach collection
# 3. Ingest GovCloud architecture docs, FedRAMP guides, service patterns
#    Also ingest Azure docs and Azure→AWS migration patterns for Migration feature
BEDROCK_KNOWLEDGE_BASE_ID=

# Force mock mode without AWS credentials (local dev)
# BEDROCK_MOCK_MODE=true

# Optional DynamoDB persistence
# USE_DYNAMODB=true
# DYNAMODB_PROJECTS_TABLE=CloudArch-Projects
# DYNAMODB_MESSAGES_TABLE=CloudArch-Messages
